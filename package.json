{
  "name": "isitayush.dev",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "build": "velite build && next build",
    "clean": "find . -name node_modules -o -name .velite -o -name .next -type d -prune | xargs rm -rf",
    "db:gen": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset",
    "dev": "next dev",
    "format": "prettier . --check --cache --cache-location='node_modules/.cache/.prettiercache'",
    "format:fix": "prettier . --write --cache --cache-location='node_modules/.cache/.prettiercache' --log-level=warn",
    "postinstall": "prisma generate",
    "lint": "eslint . --cache --cache-location node_modules/.cache/.eslintcache --max-warnings 0",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/.eslintcache --max-warnings 0",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "typegen": "velite build && pnpm db:gen"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@next/bundle-analyzer": "^16.4.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@vercel/og": "^1.0.3",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.8",
    "framer-motion": "^14.4.0",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "next-auth": "^4.24.15",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-highlight-words": "^1.0.0",
    "react-hook-form": "^7.90.0",
    "react-hotkeys-hook": "^5.3.3",
    "react-wrap-balancer": "^1.1.1",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "rss": "^1.2.2",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "velite": "^0.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-highlight-words": "^0.20.1",
    "@types/rss": "^0.0.32",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "10.13.0",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-packagejson": "^3.0.2",
    "prisma": "7.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
